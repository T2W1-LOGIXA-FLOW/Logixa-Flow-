# ==============================================================================
# LOGIXA-FLOW: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# (Non-Docker Native / Systemd / PM2 Deployment)
#
# Instructions:
# 1. Copy this file to .env or apps/web-platform/backend/.env
# 2. Populate all empty values with real production secrets.
# 3. Restrict permissions (chmod 600 .env).
# ==============================================================================

# --- RUNTIME & SERVER ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
PORT=8003
HOST=127.0.0.1
BACKEND_URL=https://api.logixa.yourdomain.com

# --- SECURITY & AUTHENTICATION TOKENS ---
# Generate strong 32-byte tokens for each
API_SECRET_TOKEN=replace-with-secure-api-secret-token
JWT_SECRET=replace-with-secure-user-jwt-secret
JWT_ADMIN_SECRET=replace-with-secure-admin-jwt-secret
PREVIEW_TOKEN=replace-with-secure-preview-token
AGENT_SERVICE_TOKEN=replace-with-secure-agent-token

# --- CORS & NETWORK HARDENING ---
# Strict comma-separated list of origins (NO wildcards '*')
CORS_ORIGINS=https://logixa.yourdomain.com,https://admin.logixa.yourdomain.com
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
USE_SLOWAPI=true

# --- DATABASE & CONNECTION POOLING (PostgreSQL / Supabase) ---
DATABASE_PROFILE=postgres
# Example: postgresql+psycopg2://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/logixa_flow_prod?sslmode=require
DB_CONNECT_RETRIES=15
DB_CONNECT_RETRY_DELAY=2

# --- REDIS CACHE & CELERY BACKGROUND SCHEDULER ---
# Production recommendation: Upstash Redis
REDIS_URL=redis://default:password@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://default:password@127.0.0.1:6379/1
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_HOURS=24
WORKER_MODE=web-pipeline
WORKER_INTERVAL_SECONDS=3600
WORKER_RUN_ON_START=true
WORKER_ONCE=false
PIPELINE_BATCH_LIMIT=5
AUTO_APPROVE_PUBLISH=false

# --- STORAGE (Backblaze B2 / AWS S3 S3-Compatible) ---
UPLOAD_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=logixa-flow-prod-vault
S3_REGION=us-west-004
S3_PUBLIC_BASE_URL=

# --- TELEGRAM BOT ALERTS & INCIDENT REPORTING ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# --- SENTRY OBSERVABILITY ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- AI PROVIDERS & MULTI-PROVIDER CASCADE ---
REQUIRE_AI_KEY=false
USER_AI_ENABLED=true
ADMIN_AI_ENABLED=true
USER_AI_PROVIDER=openrouter
ADMIN_AI_PROVIDER=openrouter
LLM_PROVIDER=openrouter

# AI Provider Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
OPENROUTER_FALLBACK_MODEL_NAME=openrouter/free

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant

MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-latest

COHERE_API_KEY=
COHERE_MODEL_NAME=command-r-plus

VOYAGE_API_KEY=

# --- RAG & VECTOR SEARCH ENGINE ---
RAG_AUTO_INGEST=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIMENSIONS=768
SEMANTIC_CACHE_TTL_SECONDS=3600
PGVECTOR_ENABLED=true
MIN_SIMILARITY_TO_MERGE=0.74

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_API_URL=https://logixa.yourdomain.com/api
NEXT_PUBLIC_SITE_URL=https://logixa.yourdomain.com
