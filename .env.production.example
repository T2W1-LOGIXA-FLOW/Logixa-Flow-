# ==============================================================================
# LOGIXA-FLOW: PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Target Deployment: Render (API Backend & Celery Worker), Vercel (Web Flagship)
# Architecture: 100% Standalone Decoupled Multi-Agent Workflow Engine
# Format: [Platform / Component Target] [Variable Name]=
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER — BACKEND API (Core Web Service)
# ------------------------------------------------------------------------------
# Render — Backend API	ENVIRONMENT
ENVIRONMENT=production

# Render — Backend API	DEBUG
DEBUG=false

# Render — Backend API	LOG_LEVEL
LOG_LEVEL=INFO

# Render — Backend API	STRUCTURED_LOGS
STRUCTURED_LOGS=true

# Render — Backend API	PORT
PORT=8000

# Render — Backend API	HOST
HOST=0.0.0.0

# Render — Backend API	BACKEND_URL
BACKEND_URL=https://logixa-flow-api.onrender.com

# Render — Backend API	FRONTEND_BASE_URL
FRONTEND_BASE_URL=https://logixa-flow.vercel.app

# Render — Backend API	CORS_ORIGINS
CORS_ORIGINS=https://logixa-flow.vercel.app,https://admin.logixa-flow.vercel.app

# Render — Backend API	CORS_EXTRA_ORIGINS
CORS_EXTRA_ORIGINS=

# Render — Backend API	TRUSTED_HOSTS
TRUSTED_HOSTS=logixa-flow-api.onrender.com,localhost,127.0.0.1

# Render — Backend API	API_SECRET_TOKEN (Generate with: openssl rand -hex 32)
API_SECRET_TOKEN=

# Render — Backend API	JWT_SECRET (Generate with: openssl rand -hex 32)
JWT_SECRET=

# Render — Backend API	JWT_ADMIN_SECRET (Generate with: openssl rand -hex 32)
JWT_ADMIN_SECRET=

# Render — Backend API	PREVIEW_TOKEN
PREVIEW_TOKEN=

# Render — Backend API	AGENT_SERVICE_TOKEN
AGENT_SERVICE_TOKEN=

# Render — Backend API	ENABLE_RATE_LIMIT
ENABLE_RATE_LIMIT=true

# Render — Backend API	RATE_LIMIT_REQUESTS
RATE_LIMIT_REQUESTS=120

# Render — Backend API	RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_WINDOW_SECONDS=60

# Render — Backend API	USE_SLOWAPI
USE_SLOWAPI=true

# Render — Backend API	DATABASE_PROFILE
DATABASE_PROFILE=postgres

# Render — Backend API	DATABASE_URL (PostgreSQL pooled connection string)
DATABASE_URL=

# Render — Backend API	DB_CONNECT_RETRIES
DB_CONNECT_RETRIES=15

# Render — Backend API	DB_CONNECT_RETRY_DELAY
DB_CONNECT_RETRY_DELAY=2

# Render — Backend API	SENTRY_DSN
SENTRY_DSN=

# Render — Backend API	SENTRY_ENVIRONMENT
SENTRY_ENVIRONMENT=production

# Render — Backend API	SENTRY_TRACES_SAMPLE_RATE
SENTRY_TRACES_SAMPLE_RATE=0.2

# ------------------------------------------------------------------------------
# 2. RENDER — MULTI-STORAGE MATRIX (Backblaze B2, Cloudinary, Supabase, Local)
# ------------------------------------------------------------------------------
# Render — Storage	UPLOAD_STORAGE_BACKEND (s3, cloudinary, supabase, local)
UPLOAD_STORAGE_BACKEND=s3

# Render — Storage	S3_ENDPOINT_URL
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Render — Storage	S3_ACCESS_KEY_ID
S3_ACCESS_KEY_ID=

# Render — Storage	S3_SECRET_ACCESS_KEY
S3_SECRET_ACCESS_KEY=

# Render — Storage	S3_BUCKET
S3_BUCKET=logixa-flow-prod-vault

# Render — Storage	S3_REGION
S3_REGION=us-west-004

# Render — Storage	S3_PUBLIC_BASE_URL
S3_PUBLIC_BASE_URL=

# Render — Storage	CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=

# Render — Storage	CLOUDINARY_API_KEY
CLOUDINARY_API_KEY=

# Render — Storage	CLOUDINARY_API_SECRET
CLOUDINARY_API_SECRET=

# Render — Storage	SUPABASE_URL
SUPABASE_URL=

# Render — Storage	SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. RENDER — MULTI-PROVIDER AI FAILOVER CASCADE (Agent & Workflow Orchestration)
# ------------------------------------------------------------------------------
# Render — AI Providers	REQUIRE_AI_KEY
REQUIRE_AI_KEY=false

# Render — AI Providers	USER_AI_ENABLED
USER_AI_ENABLED=true

# Render — AI Providers	ADMIN_AI_ENABLED
ADMIN_AI_ENABLED=true

# Render — AI Providers	LLM_PROVIDER
LLM_PROVIDER=openrouter

# Render — AI Providers	OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Render — AI Providers	OPENROUTER_BASE_URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Render — AI Providers	OPENROUTER_MODEL_NAME
OPENROUTER_MODEL_NAME=openrouter/free

# Render — AI Providers	OPENROUTER_FALLBACK_MODEL_NAME
OPENROUTER_FALLBACK_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free

# Render — AI Providers	GEMINI_API_KEY
GEMINI_API_KEY=

# Render — AI Providers	GEMINI_BASE_URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Render — AI Providers	GEMINI_MODEL_NAME
GEMINI_MODEL_NAME=gemini-2.5-flash

# Render — AI Providers	GROQ_API_KEY
GROQ_API_KEY=

# Render — AI Providers	GROQ_BASE_URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Render — AI Providers	GROQ_MODEL_NAME
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Render — AI Providers	MISTRAL_API_KEY
MISTRAL_API_KEY=

# Render — AI Providers	MISTRAL_BASE_URL
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Render — AI Providers	MISTRAL_MODEL_NAME
MISTRAL_MODEL_NAME=mistral-small-latest

# Render — AI Providers	COHERE_API_KEY
COHERE_API_KEY=

# Render — AI Providers	COHERE_BASE_URL
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

# Render — AI Providers	COHERE_MODEL_NAME
COHERE_MODEL_NAME=command-r-08-2024

# Render — AI Providers	NVIDIA_API_KEY
NVIDIA_API_KEY=

# Render — AI Providers	NVIDIA_MODEL_NAME
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct

# Render — AI Providers	HUGGINGFACE_API_KEY
HUGGINGFACE_API_KEY=

# Render — AI Providers	VOYAGE_API_KEY
VOYAGE_API_KEY=

# Render — AI Providers	CLOUDFLARE_API_TOKEN
CLOUDFLARE_API_TOKEN=

# Render — AI Providers	CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 4. RENDER — QDRANT VECTOR SUPPLY-CHAIN ONTOLOGY
# ------------------------------------------------------------------------------
# Render — Qdrant	QDRANT_API_KEY
QDRANT_API_KEY=

# Render — Qdrant	QDRANT_CLUSTER_ENDPOINT
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io

# Render — Qdrant	QDRANT_COLLECTION_NAME
QDRANT_COLLECTION_NAME=logixa_workflow_ontology

# Render — RAG Engine	RAG_AUTO_INGEST
RAG_AUTO_INGEST=true

# Render — RAG Engine	RAG_CHUNK_SIZE
RAG_CHUNK_SIZE=800

# Render — RAG Engine	RAG_CHUNK_OVERLAP
RAG_CHUNK_OVERLAP=150

# Render — RAG Engine	RAG_TOP_K
RAG_TOP_K=6

# Render — RAG Engine	EMBEDDING_MODEL
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# Render — RAG Engine	EMBEDDING_DIMENSIONS
EMBEDDING_DIMENSIONS=768

# Render — RAG Engine	SEMANTIC_CACHE_TTL_SECONDS
SEMANTIC_CACHE_TTL_SECONDS=3600

# Render — RAG Engine	PGVECTOR_ENABLED
PGVECTOR_ENABLED=true

# Render — RAG Engine	MIN_SIMILARITY_TO_MERGE
MIN_SIMILARITY_TO_MERGE=0.74

# ------------------------------------------------------------------------------
# 5. RENDER — UPSTASH QSTASH & REDIS (Workflow Execution Queue & Scheduler)
# ------------------------------------------------------------------------------
# Render — Upstash QStash	QSTASH_URL
QSTASH_URL=https://qstash.upstash.io

# Render — Upstash QStash	QSTASH_TOKEN
QSTASH_TOKEN=

# Render — Upstash QStash	QSTASH_CURRENT_SIGNING_KEY
QSTASH_CURRENT_SIGNING_KEY=

# Render — Upstash QStash	QSTASH_NEXT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=

# Render — Upstash Redis	REDIS_URL
REDIS_URL=

# Render — Upstash Redis	UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_URL=

# Render — Upstash Redis	UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 6. RENDER — OBSERVABILITY, LOGS & PRIVACY ANALYTICS
# ------------------------------------------------------------------------------
# Render — Observability	AXIOM_TOKEN
AXIOM_TOKEN=

# Render — Observability	AXIOM_DATASET
AXIOM_DATASET=logixa-flow-production

# Render — Observability	UMAMI_WEBSITE_ID
UMAMI_WEBSITE_ID=

# Render — Observability	UMAMI_HOST_URL
UMAMI_HOST_URL=https://cloud.umami.is

# ------------------------------------------------------------------------------
# 7. RENDER — GOOGLE DRIVE OAUTH (Intelligence Export & Backup)
# ------------------------------------------------------------------------------
# Render — Google Drive	GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Render — Google Drive	GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=

# Render — Google Drive	GOOGLE_DRIVE_REDIRECT_URI
GOOGLE_DRIVE_REDIRECT_URI=https://logixa-flow-api.onrender.com/api/integrations/google-drive/callback

# Render — Google Drive	GOOGLE_DRIVE_REFRESH_TOKEN
GOOGLE_DRIVE_REFRESH_TOKEN=

# Render — Google Drive	GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=

# Render — Google Drive	GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Render — Google Drive	GOOGLE_OAUTH_STATE_SECRET
GOOGLE_OAUTH_STATE_SECRET=

# ------------------------------------------------------------------------------
# 8. RENDER — TELEGRAM BOT & HUMAN-IN-THE-LOOP APPROVALS
# ------------------------------------------------------------------------------
# Render — Telegram	TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# Render — Telegram	TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=

# Render — Telegram	TELEGRAM_TOPIC_ID
TELEGRAM_TOPIC_ID=

# Render — Telegram	TELEGRAM_ENABLED
TELEGRAM_ENABLED=true

# Required for secure Telegram webhook callbacks in production.
# Generate independent high-entropy values; never commit real secrets.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ACTION_SECRET=

# Comma-separated numeric Telegram IDs allowed to issue commands/callbacks.
# Configure both lists in Render before enabling production Telegram actions.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# ------------------------------------------------------------------------------
# 9. RENDER — CELERY BACKGROUND WORKER & SCHEDULER
# ------------------------------------------------------------------------------
# Render — Background Worker	CELERY_BROKER_URL
CELERY_BROKER_URL=

# Render — Background Worker	ENABLE_SCHEDULER
ENABLE_SCHEDULER=true

# Render — Background Worker	SCHEDULER_INTERVAL_HOURS
SCHEDULER_INTERVAL_HOURS=24

# Render — Background Worker	WORKER_MODE
WORKER_MODE=web-pipeline

# Render — Background Worker	WORKER_INTERVAL_SECONDS
WORKER_INTERVAL_SECONDS=3600

# Render — Background Worker	WORKER_RUN_ON_START
WORKER_RUN_ON_START=true

# Render — Background Worker	WORKER_ONCE
WORKER_ONCE=false

# Render — Background Worker	PIPELINE_BATCH_LIMIT
PIPELINE_BATCH_LIMIT=5

# Render — Background Worker	AUTO_APPROVE_PUBLISH
AUTO_APPROVE_PUBLISH=false

# ------------------------------------------------------------------------------
# 10. VERCEL — WEB FRONTEND (Public Browser Bundle)
# ------------------------------------------------------------------------------
# Vercel — Web Frontend	NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_URL=https://logixa-flow-api.onrender.com

# Vercel — Web Frontend	NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_SITE_URL=https://logixa-flow.vercel.app

# Vercel — Web Frontend	NEXT_PUBLIC_UMAMI_WEBSITE_ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vercel — Web Frontend	NEXT_PUBLIC_UMAMI_SCRIPT_URL
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
