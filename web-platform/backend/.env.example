# Backend environment template
# Copy this to .local.env for development or add the same keys in Render/Koyeb.
# Never commit real API keys, database passwords, or JWT secrets.

# Database
DATABASE_URL=sqlite:///./logixa_flow.db
DATABASE_PROFILE=sqlite
# Production Supabase example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# DATABASE_PROFILE=supabase

# Auth and admin
API_SECRET_TOKEN=change-this-before-public-deploy
JWT_SECRET=change-this-jwt-secret-before-public-deploy
JWT_ADMIN_SECRET=change-this-admin-jwt-secret-before-public-deploy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
CORS_ORIGINS=http://localhost:3000

# Public and security controls
ENVIRONMENT=development
PUBLIC_ACCESS=true
PREVIEW_TOKEN=change-this-preview-token
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
USE_SLOWAPI=true

# Cache and jobs
REDIS_URL=
ENABLE_SCHEDULER=true
USER_AI_PROVIDER=gemini
ADMIN_AI_PROVIDER=gemini
SCHEDULER_INTERVAL_HOURS=24
INTEGRATION_RSS_FEEDS=
INTEGRATION_AGENT_PROMPT=Generate a Myanmar-ready supply chain preview brief for admin review only.

# AI providers
# Separate user-facing assistant and admin/internal agent credentials when needed.
# Public user requests prefer USER_* keys; admin tasks prefer ADMIN_* keys.
# If a role-specific key is missing, the code falls back to the global key.
REQUIRE_AI_KEY=false
GEMINI_API_KEY=
USER_GEMINI_API_KEY=
ADMIN_GEMINI_API_KEY=
AI_AGENT_MODEL=local-planner
OPENROUTER_API_KEY=
USER_OPENROUTER_API_KEY=
ADMIN_OPENROUTER_API_KEY=
OPENROUTER_LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-r1:free
GROQ_API_KEY=
USER_GROQ_API_KEY=
ADMIN_GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
CEREBRAS_API_KEY=
USER_CEREBRAS_API_KEY=
ADMIN_CEREBRAS_API_KEY=
MISTRAL_API_KEY=
USER_MISTRAL_API_KEY=
ADMIN_MISTRAL_API_KEY=
COHERE_API_KEY=
USER_COHERE_API_KEY=
ADMIN_COHERE_API_KEY=
NVIDIA_NIM_API_KEY=
USER_NVIDIA_NIM_API_KEY=
ADMIN_NVIDIA_NIM_API_KEY=
HUGGINGFACE_API_KEY=

# Upload storage
# For Backblaze B2, use UPLOAD_STORAGE_BACKEND=b2 and the S3-compatible endpoint/keys.
UPLOAD_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-west-004
S3_PUBLIC_BASE_URL=

# Email and optional integrations
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@example.com
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Runtime
USE_ALEMBIC_BOOTSTRAP=true
STRUCTURED_LOGS=true
LOG_LEVEL=INFO
RAG_AUTO_INGEST=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768
SEMANTIC_CACHE_TTL_SECONDS=3600
PGVECTOR_ENABLED=false
