# ⚠️ IMPORTANT SECURITY NOTE
# This file is a TEMPLATE. Copy this to .local.env for development with real keys.
# NEVER commit .local.env or actual API keys to version control.
# .env files are ignored by .gitignore for security.

DATABASE_URL=sqlite:///./logixa_flow.db
# For PostgreSQL with pgvector: postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require
# Set DATABASE_PROFILE=neon or supabase or postgres

API_SECRET_TOKEN=change-this-before-public-deploy
JWT_SECRET=change-this-jwt-secret-before-public-deploy
JWT_ADMIN_SECRET=change-this-admin-jwt-secret-before-public-deploy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
CORS_ORIGINS=http://localhost:3000,https://logixaflow.vercel.app

PUBLIC_ACCESS=true
PREVIEW_TOKEN=change-this-preview-token
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=

ENABLE_SCHEDULER=false
# Preview-only: keep false until you want daily auto-drafts (uses API quota)
SCHEDULER_INTERVAL_HOURS=24

REQUIRE_AI_KEY=false
GEMINI_API_KEY=your-api-key-here
AI_AGENT_MODEL=local-planner
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_LLAMA_MODEL=meta-llama/llama-3-8b-instruct:free
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-r1:free
GROQ_API_KEY=your-api-key-here
HUGGINGFACE_API_KEY=your-api-key-here
CANVA_CLIENT_ID=your-client-id-here
CANVA_CLIENT_SECRET=your-client-secret-here
INTEGRATION_RSS_FEEDS=
AGENTS_DRAFTS_DIR=
INTEGRATION_AGENT_PROMPT=Generate a Myanmar-ready supply chain preview brief for admin review only.

# Resend email settings for newsletter broadcast
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Phase 1 / 2
USE_ALEMBIC_BOOTSTRAP=true
USE_SLOWAPI=true
STRUCTURED_LOGS=true
LOG_LEVEL=INFO
DATABASE_PROFILE=sqlite
RAG_AUTO_INGEST=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768
SEMANTIC_CACHE_TTL_SECONDS=3600

# PGVector / vector extension hints for production Postgres (Neon/Supabase)
# If using Neon or Supabase with the vector extension, set DATABASE_PROFILE=neon
# and ensure your DATABASE_URL points to the Postgres host with SSL as needed.
# Optional: enable explicit flag to indicate pgvector usage (example-only).
PGVECTOR_ENABLED=false
