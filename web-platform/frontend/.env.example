# ==========================================
# EMAIL CONFIGURATION
# ==========================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@logixaflow.com
EMAIL_ADMIN=admin@logixaflow.com

# SendGrid (alternative to Gmail)
SENDGRID_API_KEY=SG.your-sendgrid-key

# Resend (alternative modern email service)
RESEND_API_KEY=re_your-resend-key

# ==========================================
# PAYMENT & SUBSCRIPTION (Stripe)
# ==========================================
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-test-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-secret

# Stripe Price IDs
STRIPE_PRICE_PRO=price_1234567890abcdef
STRIPE_PRICE_ENTERPRISE=price_0987654321fedcba

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# The frontend does not connect directly to PostgreSQL in beta deploy.
# Set DATABASE_URL only on the Render backend service.

# ==========================================
# ANALYTICS (Google Analytics 4)
# ==========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=ga4_secret_key_here

# ==========================================
# ERROR TRACKING (Sentry)
# ==========================================
SENTRY_DSN=https://your-key@your-project.ingest.sentry.io/your-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ENVIRONMENT=production
SENTRY_ORG=your-organization
SENTRY_PROJECT=your-project

# ==========================================
# API CONFIGURATION
# ==========================================
# For local preview: http://localhost:8000
# For production: https://your-backend-url.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
API_SECRET_KEY=your-secret-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# SECURITY
# ==========================================
CSRF_SECRET=your-csrf-secret-key-min-32-chars
# JWT_SECRET belongs on the Render backend service.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=5

# ==========================================
# ADMIN CONFIGURATION
# ==========================================
ADMIN_EMAIL=admin@logixaflow.com
ADMIN_PASSWORD_HASH=hashed_password_here
JWT_ADMIN_SECRET=admin-jwt-secret-key

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
ENABLE_STRIPE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_ADMIN_DASHBOARD=true

# ==========================================
# OPTIONAL: THIRD-PARTY SERVICES
# ==========================================
# AWS S3 (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=logixaflow-uploads

# GitHub OAuth
GITHUB_ID=your-github-app-id
GITHUB_SECRET=your-github-app-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
