// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("pending")
  readAt    DateTime?
  adminNotes String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String
  stripeCustomerId      String?
  stripeSubscriptionId  String?  @unique
  plan                  String   @default("free")
  status                String   @default("active")
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PaymentHistory {
  id              String   @id @default(cuid())
  userId          String
  stripePaymentId String?
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  status          String
  description     String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  templateHtml String
  templateText String?
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminActivityLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  resourceType String?
  resourceId  String?
  changes     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  userId      String?
  sessionId   String
  pageUrl     String?
  eventData   Json?
  userProperties Json?
  country     String?
  browser     String?
  deviceType  String?
  timestamp   DateTime @default(now())

  @@index([eventName])
  @@index([timestamp])
  @@index([sessionId])
}
