# --- Preview mode (recommended until you publish) ---
# ENABLE_SCHEDULER=false
# AUTO_APPROVE_PUBLISH=false
# PIPELINE_BATCH_LIMIT=3
# Free-tier options: LLM_PROVIDER=openrouter | groq | gemini

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=meta-llama/llama-3-8b-instruct:free
OPENROUTER_FALLBACK_MODEL_NAME=deepseek/deepseek-r1:free
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_NAME=
TEMPERATURE=0.55
PIPELINE_BATCH_LIMIT=3
STRICT_LLM_ERRORS=false

BACKEND_URL=http://localhost:8000
POSTGRES_USER=logixa
POSTGRES_PASSWORD=logixa_password
POSTGRES_DB=logixa_flow
DATABASE_URL=postgresql://logixa:logixa_password@db:5432/logixa_flow
API_SECRET_TOKEN=change-this-before-public-deploy
JWT_SECRET=change-this-jwt-secret-before-public-deploy
JWT_ADMIN_SECRET=change-this-admin-jwt-secret-before-public-deploy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=LogixaAdmin123!
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated RSS feeds for /api/admin/integration/sync-feeds (empty = built-in defaults)
INTEGRATION_RSS_FEEDS=

# Cost tracking estimates (per-1k tokens)
AI_COST_PER_1K=0.002
EMBEDDING_COST_PER_1K=0.0004

# Optional: Celery broker URL for queued tasks (e.g., redis://redis:6379/0)
CELERY_BROKER_URL=
