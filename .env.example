# Logixa Flow environment template
# Copy the needed values into each host dashboard. Never commit real secrets.

# Backend URL used by local tooling
BACKEND_URL=http://localhost:8000

# Database
# Local preview can use SQLite. Production should use Supabase Postgres.
DATABASE_URL=sqlite:///./logixa_flow.db
DATABASE_PROFILE=sqlite

# Auth and admin
API_SECRET_TOKEN=change-this-before-public-deploy
JWT_SECRET=change-this-jwt-secret-before-public-deploy
JWT_ADMIN_SECRET=change-this-admin-jwt-secret-before-public-deploy
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI providers
# Cost policy: all LLM generation uses only OpenRouter openrouter/free.
# Other provider keys below are legacy/inactive for generation; they are not fallback routes.
REQUIRE_AI_KEY=false
# Public AI is disabled by default; admin AI remains enabled by default.
USER_AI_ENABLED=false
ADMIN_AI_ENABLED=true
LLM_PROVIDER=openrouter
GEMINI_API_KEY=
USER_GEMINI_API_KEY=
ADMIN_GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENROUTER_API_KEY=
USER_OPENROUTER_API_KEY=
ADMIN_OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
OPENROUTER_FALLBACK_MODEL_NAME=openrouter/free
GROQ_API_KEY=
USER_GROQ_API_KEY=
ADMIN_GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant
CEREBRAS_API_KEY=
USER_CEREBRAS_API_KEY=
ADMIN_CEREBRAS_API_KEY=
CEREBRAS_MODEL_NAME=gpt-oss-120b
MISTRAL_API_KEY=
USER_MISTRAL_API_KEY=
ADMIN_MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-latest
COHERE_API_KEY=
USER_COHERE_API_KEY=
ADMIN_COHERE_API_KEY=
COHERE_MODEL_NAME=command-r-plus
NVIDIA_NIM_API_KEY=
USER_NVIDIA_NIM_API_KEY=
ADMIN_NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL_NAME=meta/llama-3.1-8b-instruct
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_NAME=
TEMPERATURE=0.55
STRICT_LLM_ERRORS=false

# Cache and background jobs
# Production recommendation: Upstash Redis.
REDIS_URL=
CELERY_BROKER_URL=
ENABLE_SCHEDULER=true
USER_AI_PROVIDER=openrouter
ADMIN_AI_PROVIDER=openrouter
SCHEDULER_INTERVAL_HOURS=24
AUTO_APPROVE_PUBLISH=false
PIPELINE_BATCH_LIMIT=3
INTEGRATION_RSS_FEEDS=
WORKER_MODE=web-pipeline
WORKER_INTERVAL_SECONDS=3600
WORKER_RUN_ON_START=true
WORKER_ONCE=false
AGENT_SERVICE_TOKEN=

# Upload storage
# Local fallback stores files in web-platform/backend/uploads.
# Production recommendation: Backblaze B2 using S3-compatible credentials.
UPLOAD_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-west-004
S3_PUBLIC_BASE_URL=

# Runtime and observability
ENVIRONMENT=development
PUBLIC_ACCESS=true
PREVIEW_TOKEN=change-this-preview-token
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
USE_SLOWAPI=true
STRUCTURED_LOGS=true
LOG_LEVEL=INFO

# RAG and vector search
RAG_AUTO_INGEST=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIMENSIONS=768
SEMANTIC_CACHE_TTL_SECONDS=3600
PGVECTOR_ENABLED=false
MIN_SIMILARITY_TO_MERGE=0.74

# Cost tracking estimates
AI_COST_PER_1K=0
EMBEDDING_COST_PER_1K=0.0004
