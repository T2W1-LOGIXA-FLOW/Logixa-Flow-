# Frontend environment template
# Copy this file to .env.local for local development or set the same values in your hosting platform.
# Do not commit real secrets.

# Required frontend variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_PRICE_ID=price_your_price_id
EMAIL_FROM=noreply@yourdomain.com
EMAIL_SERVER_HOST=smtp.yourdomain.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email-user
EMAIL_SERVER_PASSWORD=your-email-password
ADMIN_EMAIL=admin@yourdomain.com
OPENAI_API_KEY=your_openai_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Logixa Flow
NEXT_PUBLIC_ENVIRONMENT=development

# Optional frontend variables
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=avatars
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment / observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=

# Security / rate limiting
CSRF_SECRET=replace-with-32-plus-char-random-secret
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=5

# Legacy / optional service variables
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_ADMIN=admin@logixaflow.com
SENDGRID_API_KEY=
RESEND_API_KEY=
GA4_API_SECRET=
ENABLE_STRIPE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_ADMIN_DASHBOARD=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=logixaflow-uploads
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_WEBHOOK_URL=
